{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.0",
      "pnpm": "9.0.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://rpg-api.codewaveds.com.br"
      }
    },
    "simulator": {
      "extends": "base",
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
